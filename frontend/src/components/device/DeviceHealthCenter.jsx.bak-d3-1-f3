import {
  Activity,
  AlertTriangle,
  BrainCircuit,
  CheckCircle2,
  CircleAlert,
  Cpu,
  Gauge,
  HardDrive,
  Network,
  ShieldAlert,
  Sparkles,
  Wifi,
} from 'lucide-react'

import {
  calculateDeviceHealth,
} from '../../utils/healthEngine'


import { SSGauge } from '../ui'

const SECTION_CONFIG = {
  connectivity: {
    label: 'الاتصال',
    englishLabel: 'Connectivity',
    maximum: 20,
    icon: Wifi,
  },

  cpu: {
    label: 'المعالج',
    englishLabel: 'CPU',
    maximum: 20,
    icon: Cpu,
  },

  memory: {
    label: 'الذاكرة',
    englishLabel: 'Memory',
    maximum: 15,
    icon: HardDrive,
  },

  interfaces: {
    label: 'الواجهات',
    englishLabel: 'Interfaces',
    maximum: 20,
    icon: Network,
  },

  errors: {
    label: 'الأخطاء',
    englishLabel: 'Errors',
    maximum: 15,
    icon: ShieldAlert,
  },

  utilization: {
    label: 'الاستخدام',
    englishLabel: 'Utilization',
    maximum: 10,
    icon: Gauge,
  },
}


const SEVERITY_PRIORITY = {
  critical: 5,
  warning: 4,
  notice: 3,
  info: 2,
  healthy: 1,
}


function getSeverityPresentation(
  severity,
) {
  const presentations = {
    critical: {
      label: 'حرج',
      englishLabel: 'Critical',
      tone: 'critical',
      icon: CircleAlert,
    },

    warning: {
      label: 'تحذير',
      englishLabel: 'Warning',
      tone: 'warning',
      icon: AlertTriangle,
    },

    notice: {
      label: 'ملاحظة',
      englishLabel: 'Notice',
      tone: 'notice',
      icon: Sparkles,
    },

    info: {
      label: 'معلومة',
      englishLabel: 'Information',
      tone: 'info',
      icon: BrainCircuit,
    },

    healthy: {
      label: 'سليم',
      englishLabel: 'Healthy',
      tone: 'healthy',
      icon: CheckCircle2,
    },
  }

  return (
    presentations[severity] ||
    presentations.info
  )
}


function clamp(
  value,
  minimum = 0,
  maximum = 100,
) {
  return Math.max(
    minimum,
    Math.min(
      Number(value) || 0,
      maximum,
    ),
  )
}


function HealthScoreRing({
  score,
  tone,
}) {
  const normalizedScore =
    clamp(score)

  const gaugeTone =
    tone === 'healthy'
      ? 'success'
      : tone === 'warning'
        ? 'warning'
        : tone === 'critical'
          ? 'danger'
          : 'primary'

  return (
    <SSGauge
      className={
        [
          'health-pro-score-gauge',
          `health-pro-score-gauge--${tone}`,
        ].join(' ')
      }
      value={normalizedScore}
      min={0}
      max={100}
      valueSuffix="/100"
      tone={gaugeTone}
      size="lg"
      thickness={9}
      maximumFractionDigits={0}
      animated
    />
  )
}


function StatusCounter({
  title,
  value,
  tone,
  icon: Icon,
}) {
  return (
    <div
      className={`health-pro-counter ${tone}`}
    >
      <div className="health-pro-counter-icon">
        <Icon size={17} />
      </div>

      <div>
        <strong>{value}</strong>
        <span>{title}</span>
      </div>
    </div>
  )
}


function SectionCard({
  sectionKey,
  score,
}) {
  const config =
    SECTION_CONFIG[sectionKey]

  if (!config) {
    return null
  }

  const Icon = config.icon

  const percentage = clamp(
    (
      Number(score) /
      config.maximum
    ) * 100,
  )

  const tone =
    percentage >= 85
      ? 'healthy'
      : percentage >= 60
        ? 'warning'
        : 'critical'

  return (
    <div
      className={`health-pro-section-card ${tone}`}
    >
      <div className="health-pro-section-heading">
        <div className="health-pro-section-icon">
          <Icon size={17} />
        </div>

        <div>
          <strong>
            {config.label}
          </strong>

          <span>
            {config.englishLabel}
          </span>
        </div>

        <b>
          {score}/{config.maximum}
        </b>
      </div>

      <div className="health-pro-progress">
        <div
          className={`health-pro-progress-fill ${tone}`}
          style={{
            width: `${percentage}%`,
          }}
        />
      </div>

      <small>
        {percentage.toFixed(0)}%
      </small>
    </div>
  )
}


function InsightCard({
  finding,
}) {
  const presentation =
    getSeverityPresentation(
      finding.severity,
    )

  const Icon =
    presentation.icon

  return (
    <div
      className={`health-pro-insight ${presentation.tone}`}
    >
      <div className="health-pro-insight-icon">
        <Icon size={17} />
      </div>

      <div className="health-pro-insight-content">
        <div className="health-pro-insight-title">
          <strong>
            {finding.title}
          </strong>

          <span>
            {presentation.label}
          </span>
        </div>

        <p>
          {finding.description}
        </p>

        {finding.interface_name && (
          <code>
            {finding.interface_name}
          </code>
        )}
      </div>
    </div>
  )
}


function TimelineItem({
  finding,
}) {
  const presentation =
    getSeverityPresentation(
      finding.severity,
    )

  const Icon =
    presentation.icon

  return (
    <div
      className={`health-pro-timeline-item ${presentation.tone}`}
    >
      <div className="health-pro-timeline-marker">
        <Icon size={13} />
      </div>

      <div className="health-pro-timeline-content">
        <strong>
          {finding.title}
        </strong>

        <span>
          {finding.description}
        </span>
      </div>

      <time>
        الآن
      </time>
    </div>
  )
}


export default function DeviceHealthCenter({
  isOnline,
  cpuUsage,
  memoryUsage,
  interfaces = [],
}) {
  const health =
    calculateDeviceHealth({
      isOnline,
      cpuUsage,
      memoryUsage,
      interfaces,
    })

  const prioritizedFindings =
    [...health.findings].sort(
      (first, second) =>
        (
          SEVERITY_PRIORITY[
            second.severity
          ] || 0
        ) -
        (
          SEVERITY_PRIORITY[
            first.severity
          ] || 0
        ),
    )

  const importantInsights =
    prioritizedFindings
      .filter(
        (finding) =>
          finding.severity !==
          'info',
      )
      .slice(0, 4)

  const timelineFindings =
    prioritizedFindings
      .filter(
        (finding) =>
          finding.severity ===
            'critical' ||
          finding.severity ===
            'warning' ||
          finding.severity ===
            'notice',
      )
      .slice(0, 4)

  const recommendation =
    health.primaryRecommendation

  return (
    <article className="panel health-pro-panel">
      <div className="health-pro-header">
        <div>
          <p className="eyebrow">
            Enterprise Health Center Pro
          </p>

          <h3>
            مركز صحة الجهاز والشبكة
          </h3>

          <p className="health-pro-description">
            تحليل فوري للاتصال والموارد
            والواجهات والأخطاء ونسبة الاستخدام.
          </p>
        </div>

        <div className="health-pro-header-status">
          <span
            className={`health-pro-live-dot ${health.level.tone}`}
          >
            <i />

            LIVE ANALYSIS
          </span>

          <span
            className={`health-pro-level ${health.level.tone}`}
          >
            {health.level.englishLabel}
            {' '}
            ·
            {' '}
            {health.level.label}
          </span>
        </div>
      </div>

      <div className="health-pro-overview">
        <section className="health-pro-score-card">
          <HealthScoreRing
            score={health.score}
            tone={health.level.tone}
          />

          <div className="health-pro-score-details">
            <span>
              Overall Health
            </span>

            <strong>
              {health.level.label}
            </strong>

            <small>
              مستوى الخطورة:
              {' '}
              {health.risk}
            </small>
          </div>
        </section>

        <section className="health-pro-counters">
          <StatusCounter
            title="حرج"
            value={
              health.counters.critical
            }
            tone="critical"
            icon={CircleAlert}
          />

          <StatusCounter
            title="تحذير"
            value={
              health.counters.warning
            }
            tone="warning"
            icon={AlertTriangle}
          />

          <StatusCounter
            title="ملاحظات"
            value={
              health.counters.notice
            }
            tone="notice"
            icon={Sparkles}
          />

          <StatusCounter
            title="سليم"
            value={
              health.counters.healthy
            }
            tone="healthy"
            icon={CheckCircle2}
          />
        </section>

        <section
          className={`health-pro-recommendation ${recommendation.severity}`}
        >
          <div className="health-pro-recommendation-heading">
            <BrainCircuit size={19} />

            <span>
              Smart Recommendation
            </span>
          </div>

          <strong>
            {recommendation.title}
          </strong>

          <p>
            {recommendation.recommendation}
          </p>

          {recommendation.interface_name && (
            <code>
              {recommendation.interface_name}
            </code>
          )}
        </section>
      </div>

      <div className="health-pro-sections">
        {Object.entries(
          health.sections,
        ).map(
          ([
            sectionKey,
            score,
          ]) => (
            <SectionCard
              key={sectionKey}
              sectionKey={
                sectionKey
              }
              score={score}
            />
          ),
        )}
      </div>

      <div className="health-pro-lower-grid">
        <section className="health-pro-insights-panel">
          <div className="health-pro-subheader">
            <div>
              <span>
                Smart Insights
              </span>

              <strong>
                أهم التحليلات
              </strong>
            </div>

            <BrainCircuit
              size={19}
            />
          </div>

          <div className="health-pro-insights-grid">
            {importantInsights.length ? (
              importantInsights.map(
                (finding) => (
                  <InsightCard
                    key={finding.id}
                    finding={finding}
                  />
                ),
              )
            ) : (
              <div className="health-pro-empty">
                <CheckCircle2
                  size={25}
                />

                <div>
                  <strong>
                    الجهاز يعمل بصورة طبيعية
                  </strong>

                  <span>
                    لا توجد ملاحظات تشغيلية مهمة.
                  </span>
                </div>
              </div>
            )}
          </div>
        </section>

        <section className="health-pro-timeline-panel">
          <div className="health-pro-subheader">
            <div>
              <span>
                Alerts Timeline
              </span>

              <strong>
                الأحداث الحالية
              </strong>
            </div>

            <Activity size={19} />
          </div>

          <div className="health-pro-timeline-list">
            {timelineFindings.length ? (
              timelineFindings.map(
                (finding) => (
                  <TimelineItem
                    key={
                      `timeline-${finding.id}`
                    }
                    finding={finding}
                  />
                ),
              )
            ) : (
              <div className="health-pro-empty compact">
                <CheckCircle2
                  size={23}
                />

                <div>
                  <strong>
                    لا توجد أحداث تحذيرية
                  </strong>

                  <span>
                    الحالة مستقرة حاليًا.
                  </span>
                </div>
              </div>
            )}
          </div>
        </section>
      </div>
    </article>
  )
}
