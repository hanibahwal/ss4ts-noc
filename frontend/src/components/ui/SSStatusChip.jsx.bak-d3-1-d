import {
  AlertCircle,
  AlertTriangle,
  CheckCircle2,
  CircleHelp,
  Clock3,
  LoaderCircle,
  PauseCircle,
  PlayCircle,
  ShieldAlert,
  XCircle,
} from 'lucide-react'

import SSBadge from './SSBadge'

import './SSStatusChip.css'


const STATUS_CONFIG = {
  online: {
    label: 'متصل',
    tone: 'success',
    icon: CheckCircle2,
    dot: true,
  },

  offline: {
    label: 'غير متصل',
    tone: 'danger',
    icon: XCircle,
    dot: true,
  },

  healthy: {
    label: 'سليم',
    tone: 'success',
    icon: CheckCircle2,
  },

  warning: {
    label: 'تحذير',
    tone: 'warning',
    icon: AlertTriangle,
  },

  critical: {
    label: 'حرج',
    tone: 'critical',
    icon: ShieldAlert,
  },

  degraded: {
    label: 'متدهور',
    tone: 'warning',
    icon: AlertCircle,
  },

  unknown: {
    label: 'غير معروف',
    tone: 'neutral',
    icon: CircleHelp,
  },

  proposed: {
    label: 'مقترح',
    tone: 'info',
    icon: Clock3,
  },

  approved: {
    label: 'معتمد',
    tone: 'success',
    icon: CheckCircle2,
  },

  pending: {
    label: 'قيد الانتظار',
    tone: 'warning',
    icon: Clock3,
  },

  running: {
    label: 'قيد التنفيذ',
    tone: 'info',
    icon: LoaderCircle,
    pulse: true,
  },

  completed: {
    label: 'مكتمل',
    tone: 'success',
    icon: CheckCircle2,
  },

  failed: {
    label: 'فشل',
    tone: 'danger',
    icon: XCircle,
  },

  paused: {
    label: 'متوقف مؤقتًا',
    tone: 'neutral',
    icon: PauseCircle,
  },

  active: {
    label: 'نشط',
    tone: 'success',
    icon: PlayCircle,
    dot: true,
  },

  inactive: {
    label: 'غير نشط',
    tone: 'neutral',
    icon: PauseCircle,
    dot: true,
  },
}


export default function SSStatusChip({
  status = 'unknown',
  label = '',
  tone = '',
  icon = null,
  dot,
  pulse,
  variant = 'soft',
  size = 'md',
  className = '',
  showIcon = true,
  ...rest
}) {
  const normalizedStatus =
    String(
      status || 'unknown',
    ).toLowerCase()

  const config =
    STATUS_CONFIG[
      normalizedStatus
    ] ||
    STATUS_CONFIG.unknown

  const Icon =
    icon ||
    config.icon

  return (
    <SSBadge
      className={
        [
          'ss-ui-status-chip',
          `ss-ui-status-chip--${normalizedStatus}`,
          className,
        ]
          .filter(Boolean)
          .join(' ')
      }
      tone={
        tone ||
        config.tone
      }
      variant={variant}
      size={size}
      icon={
        showIcon
          ? Icon
          : null
      }
      dot={
        dot ??
        config.dot ??
        false
      }
      pulse={
        pulse ??
        config.pulse ??
        false
      }
      data-status={
        normalizedStatus
      }
      {...rest}
    >
      {label ||
        config.label}
    </SSBadge>
  )
}

export {
  STATUS_CONFIG,
}
