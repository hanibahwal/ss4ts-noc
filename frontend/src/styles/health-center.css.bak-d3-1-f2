/* =========================================================
   SS4TS NOC Enterprise
   Sprint 1.4.4 — Enterprise Health Center Pro
   ========================================================= */

.health-pro-panel {
  position: relative;
  width: 100%;
  min-width: 0;
  height: auto !important;
  min-height: 0 !important;
  margin: 18px 0;
  padding: 20px;
  overflow: hidden;
  grid-column: 1 / -1;
  box-sizing: border-box;
}

.health-pro-panel::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 2px;
  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(16, 185, 129, 0.9),
      rgba(59, 130, 246, 0.9),
      rgba(139, 92, 246, 0.85),
      transparent
    );
}

.health-pro-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  padding-bottom: 15px;
  border-bottom:
    1px solid rgba(148, 163, 184, 0.11);
}

.health-pro-header h3 {
  margin: 3px 0 0;
  color: #f1f5f9;
}

.health-pro-description {
  margin: 6px 0 0;
  color: #7187a1;
  font-size: 0.72rem;
}

.health-pro-header-status {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.health-pro-live-dot,
.health-pro-level {
  min-height: 27px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 0 10px;
  border: 1px solid;
  border-radius: 999px;
  font-size: 0.62rem;
  font-weight: 800;
}

.health-pro-live-dot {
  border-color: rgba(16, 185, 129, 0.25);
  background: rgba(16, 185, 129, 0.07);
  color: #34d399;
  letter-spacing: 0.06em;
}

.health-pro-live-dot i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #34d399;
  box-shadow:
    0 0 0 4px rgba(16, 185, 129, 0.09),
    0 0 10px rgba(16, 185, 129, 0.7);
}

.health-pro-level.excellent,
.health-pro-level.good {
  border-color: rgba(16, 185, 129, 0.25);
  background: rgba(16, 185, 129, 0.07);
  color: #34d399;
}

.health-pro-level.warning {
  border-color: rgba(245, 158, 11, 0.28);
  background: rgba(245, 158, 11, 0.08);
  color: #fbbf24;
}

.health-pro-level.critical {
  border-color: rgba(239, 68, 68, 0.28);
  background: rgba(239, 68, 68, 0.08);
  color: #f87171;
}

.health-pro-overview {
  display: grid;
  grid-template-columns:
    minmax(230px, 0.8fr)
    minmax(380px, 1.4fr)
    minmax(320px, 1.2fr);
  gap: 11px;
  margin-top: 15px;
}

.health-pro-score-card,
.health-pro-counters,
.health-pro-recommendation,
.health-pro-insights-panel,
.health-pro-timeline-panel {
  border:
    1px solid rgba(148, 163, 184, 0.1);
  border-radius: 12px;
  background:
    linear-gradient(
      145deg,
      rgba(15, 31, 54, 0.72),
      rgba(9, 23, 42, 0.5)
    );
}

.health-pro-score-card {
  min-height: 128px;
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 15px;
}

.health-pro-score-ring {
  --ring-color: #10b981;

  width: 94px;
  height: 94px;
  flex: 0 0 94px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background:
    conic-gradient(
      var(--ring-color)
      var(--health-progress),
      rgba(100, 116, 139, 0.14)
      0deg
    );
  box-shadow:
    0 0 28px rgba(16, 185, 129, 0.08);
}

.health-pro-score-ring.excellent,
.health-pro-score-ring.good {
  --ring-color: #10b981;
}

.health-pro-score-ring.warning {
  --ring-color: #f59e0b;
}

.health-pro-score-ring.critical {
  --ring-color: #ef4444;
}

.health-pro-score-inner {
  width: 72px;
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border-radius: 50%;
  background: #0a192c;
  box-shadow:
    inset 0 0 0 1px
    rgba(148, 163, 184, 0.1);
}

.health-pro-score-inner strong {
  color: #f8fafc;
  font-size: 1.65rem;
  line-height: 1;
}

.health-pro-score-inner span {
  margin-top: 3px;
  color: #7187a1;
  font-size: 0.58rem;
}

.health-pro-score-details span,
.health-pro-score-details small {
  display: block;
  color: #7187a1;
  font-size: 0.66rem;
}

.health-pro-score-details strong {
  display: block;
  margin: 7px 0;
  color: #f1f5f9;
  font-size: 1rem;
}

.health-pro-counters {
  min-height: 128px;
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 8px;
  padding: 10px;
}

.health-pro-counter {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px;
  border:
    1px solid rgba(148, 163, 184, 0.08);
  border-radius: 9px;
  background: rgba(6, 18, 34, 0.3);
}

.health-pro-counter-icon {
  width: 31px;
  height: 31px;
  flex: 0 0 31px;
  display: grid;
  place-items: center;
  border-radius: 9px;
}

.health-pro-counter strong {
  display: block;
  color: #f1f5f9;
  font-size: 0.92rem;
}

.health-pro-counter span {
  display: block;
  margin-top: 2px;
  color: #7187a1;
  font-size: 0.61rem;
}

.health-pro-counter.critical
.health-pro-counter-icon {
  background: rgba(239, 68, 68, 0.1);
  color: #f87171;
}

.health-pro-counter.warning
.health-pro-counter-icon {
  background: rgba(245, 158, 11, 0.1);
  color: #fbbf24;
}

.health-pro-counter.notice
.health-pro-counter-icon {
  background: rgba(59, 130, 246, 0.1);
  color: #60a5fa;
}

.health-pro-counter.healthy
.health-pro-counter-icon {
  background: rgba(16, 185, 129, 0.1);
  color: #34d399;
}

.health-pro-recommendation {
  min-height: 128px;
  padding: 14px;
}

.health-pro-recommendation.critical {
  border-color: rgba(239, 68, 68, 0.2);
}

.health-pro-recommendation.warning {
  border-color: rgba(245, 158, 11, 0.2);
}

.health-pro-recommendation-heading {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #60a5fa;
  font-size: 0.65rem;
  font-weight: 800;
}

.health-pro-recommendation > strong {
  display: block;
  margin-top: 11px;
  color: #f1f5f9;
  font-size: 0.84rem;
}

.health-pro-recommendation p {
  display: -webkit-box;
  margin: 7px 0 0;
  overflow: hidden;
  color: #8ca0b7;
  font-size: 0.68rem;
  line-height: 1.75;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.health-pro-recommendation code,
.health-pro-insight code {
  display: inline-flex;
  margin-top: 7px;
  padding: 3px 7px;
  border-radius: 6px;
  background: rgba(59, 130, 246, 0.08);
  color: #60a5fa;
  font-size: 0.58rem;
}

.health-pro-sections {
  display: grid;
  grid-template-columns:
    repeat(6, minmax(0, 1fr));
  gap: 9px;
  margin-top: 11px;
}

.health-pro-section-card {
  min-width: 0;
  padding: 11px;
  border:
    1px solid rgba(148, 163, 184, 0.09);
  border-radius: 10px;
  background: rgba(8, 22, 40, 0.52);
}

.health-pro-section-heading {
  display: flex;
  align-items: center;
  gap: 8px;
}

.health-pro-section-icon {
  width: 29px;
  height: 29px;
  flex: 0 0 29px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: rgba(59, 130, 246, 0.09);
  color: #60a5fa;
}

.health-pro-section-heading > div:nth-child(2) {
  min-width: 0;
}

.health-pro-section-heading strong,
.health-pro-section-heading span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.health-pro-section-heading strong {
  color: #dce6f3;
  font-size: 0.68rem;
}

.health-pro-section-heading span {
  margin-top: 2px;
  color: #536a84;
  font-size: 0.52rem;
}

.health-pro-section-heading b {
  margin-inline-start: auto;
  color: #9fb1c6;
  font-size: 0.62rem;
}

.health-pro-progress {
  height: 5px;
  margin-top: 10px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(100, 116, 139, 0.15);
}

.health-pro-progress-fill {
  height: 100%;
  border-radius: inherit;
}

.health-pro-progress-fill.healthy {
  background:
    linear-gradient(
      90deg,
      #10b981,
      #34d399
    );
}

.health-pro-progress-fill.warning {
  background:
    linear-gradient(
      90deg,
      #f59e0b,
      #fbbf24
    );
}

.health-pro-progress-fill.critical {
  background:
    linear-gradient(
      90deg,
      #dc2626,
      #f87171
    );
}

.health-pro-section-card > small {
  display: block;
  margin-top: 5px;
  color: #536a84;
  font-size: 0.53rem;
  text-align: left;
}

.health-pro-lower-grid {
  display: grid;
  grid-template-columns:
    minmax(0, 1.35fr)
    minmax(300px, 0.65fr);
  gap: 11px;
  margin-top: 11px;
}

.health-pro-insights-panel,
.health-pro-timeline-panel {
  min-width: 0;
  padding: 13px;
}

.health-pro-subheader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-bottom: 10px;
  color: #60a5fa;
}

.health-pro-subheader span,
.health-pro-subheader strong {
  display: block;
}

.health-pro-subheader span {
  color: #60a5fa;
  font-size: 0.55rem;
  font-weight: 800;
}

.health-pro-subheader strong {
  margin-top: 3px;
  color: #e2e8f0;
  font-size: 0.76rem;
}

.health-pro-insights-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.health-pro-insight {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 9px;
  padding: 10px;
  border:
    1px solid rgba(148, 163, 184, 0.08);
  border-radius: 9px;
  background: rgba(6, 18, 34, 0.27);
}

.health-pro-insight.critical {
  border-color: rgba(239, 68, 68, 0.16);
}

.health-pro-insight.warning {
  border-color: rgba(245, 158, 11, 0.16);
}

.health-pro-insight-icon {
  width: 29px;
  height: 29px;
  flex: 0 0 29px;
  display: grid;
  place-items: center;
  border-radius: 8px;
}

.health-pro-insight.critical
.health-pro-insight-icon {
  background: rgba(239, 68, 68, 0.1);
  color: #f87171;
}

.health-pro-insight.warning
.health-pro-insight-icon {
  background: rgba(245, 158, 11, 0.1);
  color: #fbbf24;
}

.health-pro-insight.notice
.health-pro-insight-icon,
.health-pro-insight.info
.health-pro-insight-icon {
  background: rgba(59, 130, 246, 0.1);
  color: #60a5fa;
}

.health-pro-insight.healthy
.health-pro-insight-icon {
  background: rgba(16, 185, 129, 0.1);
  color: #34d399;
}

.health-pro-insight-content {
  min-width: 0;
  flex: 1;
}

.health-pro-insight-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.health-pro-insight-title strong {
  overflow: hidden;
  color: #dce6f3;
  font-size: 0.67rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.health-pro-insight-title span {
  flex: 0 0 auto;
  color: #7187a1;
  font-size: 0.52rem;
}

.health-pro-insight p {
  display: -webkit-box;
  margin: 5px 0 0;
  overflow: hidden;
  color: #7187a1;
  font-size: 0.6rem;
  line-height: 1.65;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.health-pro-timeline-list {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.health-pro-timeline-item {
  min-width: 0;
  display: grid;
  grid-template-columns:
    27px minmax(0, 1fr) auto;
  align-items: center;
  gap: 8px;
  padding: 8px;
  border-radius: 8px;
  background: rgba(6, 18, 34, 0.27);
}

.health-pro-timeline-marker {
  width: 27px;
  height: 27px;
  display: grid;
  place-items: center;
  border-radius: 8px;
}

.health-pro-timeline-item.critical
.health-pro-timeline-marker {
  background: rgba(239, 68, 68, 0.1);
  color: #f87171;
}

.health-pro-timeline-item.warning
.health-pro-timeline-marker {
  background: rgba(245, 158, 11, 0.1);
  color: #fbbf24;
}

.health-pro-timeline-item.notice
.health-pro-timeline-marker {
  background: rgba(59, 130, 246, 0.1);
  color: #60a5fa;
}

.health-pro-timeline-content {
  min-width: 0;
}

.health-pro-timeline-content strong,
.health-pro-timeline-content span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.health-pro-timeline-content strong {
  color: #dce6f3;
  font-size: 0.62rem;
}

.health-pro-timeline-content span {
  margin-top: 3px;
  color: #536a84;
  font-size: 0.53rem;
}

.health-pro-timeline-item time {
  color: #536a84;
  font-size: 0.5rem;
}

.health-pro-empty {
  min-height: 90px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 11px;
  grid-column: 1 / -1;
  color: #34d399;
}

.health-pro-empty.compact {
  min-height: 70px;
}

.health-pro-empty strong,
.health-pro-empty span {
  display: block;
}

.health-pro-empty strong {
  color: #cbd5e1;
  font-size: 0.7rem;
}

.health-pro-empty span {
  margin-top: 3px;
  color: #7187a1;
  font-size: 0.58rem;
}

@media (max-width: 1450px) {
  .health-pro-overview {
    grid-template-columns:
      minmax(230px, 1fr)
      minmax(360px, 1.5fr);
  }

  .health-pro-recommendation {
    grid-column: 1 / -1;
  }

  .health-pro-sections {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 950px) {
  .health-pro-header {
    flex-direction: column;
  }

  .health-pro-overview,
  .health-pro-lower-grid {
    grid-template-columns: 1fr;
  }

  .health-pro-sections {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .health-pro-panel {
    padding: 14px;
  }

  .health-pro-score-card {
    flex-direction: column;
    text-align: center;
  }

  .health-pro-counters,
  .health-pro-sections,
  .health-pro-insights-grid {
    grid-template-columns: 1fr;
  }

  .health-pro-header-status {
    width: 100%;
  }
}
